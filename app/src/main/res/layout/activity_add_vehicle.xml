<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:padding="16.dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16.dp"
            android:text="Ajouter / Modifier un Document"
            android:textColor="#0F2537"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Nom Véhicule -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Véhicule :"
            android:textColor="#1F2937"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etVehicleName"
            android:layout_width="match_parent"
            android:layout_height="48.dp"
            android:layout_marginTop="4.dp"
            android:layout_marginBottom="12.dp"
            android:background="@android:color/white"
            android:hint="Ex: Toyota RAV4"
            android:inputType="text"
            android:paddingHorizontal="12.dp"
            android:textColor="#1F2937"
            android:textColorHint="#9CA3AF" />

        <!-- Immatriculation -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Immatriculation :"
            android:textColor="#1F2937"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etLicensePlate"
            android:layout_width="match_parent"
            android:layout_height="48.dp"
            android:layout_marginTop="4.dp"
            android:layout_marginBottom="12.dp"
            android:background="@android:color/white"
            android:hint="Ex: B-4567 CD"
            android:inputType="text"
            android:paddingHorizontal="12.dp"
            android:textColor="#1F2937"
            android:textColorHint="#9CA3AF" />

        <!-- Propriétaire -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Propriétaire :"
            android:textColor="#1F2937"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etOwnerName"
            android:layout_width="match_parent"
            android:layout_height="48.dp"
            android:layout_marginTop="4.dp"
            android:layout_marginBottom="8.dp"
            android:background="@android:color/white"
            android:hint="Nom du propriétaire"
            android:inputType="textPersonName"
            android:paddingHorizontal="12.dp"
            android:textColor="#1F2937"
            android:textColorHint="#9CA3AF" />

        <EditText
            android:id="@+id/etOwnerPhone"
            android:layout_width="match_parent"
            android:layout_height="48.dp"
            android:layout_marginBottom="12.dp"
            android:background="@android:color/white"
            android:hint="Téléphone (ex: 97000000)"
            android:inputType="phone"
            android:paddingHorizontal="12.dp"
            android:textColor="#1F2937"
            android:textColorHint="#9CA3AF" />

        <!-- Date d'Expiration -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date d'Échéance / Expiration :"
            android:textColor="#1F2937"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPickExpiryDate"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="48.dp"
            android:layout_marginTop="4.dp"
            android:layout_marginBottom="4.dp"
            android:backgroundTint="@android:color/white"
            android:text="📅 Sélectionner la Date"
            android:textColor="#1F2937" />

        <TextView
            android:id="@+id/tvSelectedDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16.dp"
            android:text="Aucune date sélectionnée"
            android:textColor="#6B7280"
            android:textSize="12sp" />

        <!-- Choix du justificatif -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Justificatif"
            android:textColor="#1F2937"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8.dp"
            android:layout_marginBottom="8.dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSelectPhoto"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="60.dp"
                android:layout_marginEnd="4.dp"
                android:layout_weight="1"
                android:backgroundTint="@android:color/white"
                android:text="📷 Photo / Galerie"
                android:textColor="#1F2937"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSelectPdf"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="60.dp"
                android:layout_marginStart="4.dp"
                android:layout_weight="1"
                android:backgroundTint="@android:color/white"
                android:text="📄 Fichier PDF"
                android:textColor="#1F2937"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPdfStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24.dp"
            android:text="Aucun fichier attaché"
            android:textColor="#6B7280"
            android:textSize="12sp" />

        <!-- Enregistrer -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="54.dp"
            android:backgroundTint="#2E7D32"
            android:text="Enregistrer le Document"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
