<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:padding="16.dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16.dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:text="Ajouter / Modifier un Document"
                android:textColor="#0F2537"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Saisie Véhicule -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Véhicule :"
            android:textColor="#1F2937"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etVehicleName"
            android:layout_width="match_parent"
            android:layout_height="48.dp"
            android:layout_marginTop="4.dp"
            android:layout_marginBottom="12.dp"
            android:background="@android:color/white"
            android:hint="Ex: Toyota RAV4"
            android:inputType="text"
            android:paddingHorizontal="12.dp"
            android:textColor="#1F2937"
            android:textColorHint="#9CA3AF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Immatriculation :"
            android:textColor="#1F2937"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etLicensePlate"
            android:layout_width="match_parent"
            android:layout_height="48.dp"
            android:layout_marginTop="4.dp"
            android:layout_marginBottom="12.dp"
            android:background="@android:color/white"
            android:hint="Ex: B-4567 CD"
            android:inputType="text"
            android:paddingHorizontal="12.dp"
            android:textColor="#1F2937"
            android:textColorHint="#9CA3AF" />

        <!-- Propriétaire -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Propriétaire :"
            android:textColor="#1F2937"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etOwnerName"
            android:layout_width="match_parent"
            android:layout_height="48.dp"
            android:layout_marginTop="4.dp"
            android:layout_marginBottom="12.dp"
            android:background="@android:color/white"
            android:hint="Nom du propriétaire"
            android:inputType="textPersonName"
            android:paddingHorizontal="12.dp"
            android:textColor="#1F2937"
            android:textColorHint="#9CA3AF" />

        <!-- Date d'Expiration -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date d'Échéance / Expiration :"
            android:textColor="#1F2937"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPickExpiryDate"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="48.dp"
            android:layout_marginTop="4.dp"
            android:layout_marginBottom="4.dp"
            android:backgroundTint="@android:color/white"
            android:text="📅 Sélectionner la Date"
            android:textColor="#1F2937" />

        <TextView
            android:id="@+id/tvSelectedDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16.dp"
            android:text="Aucune date sélectionnée"
            android:textColor="#6B7280"
            android:textSize="12sp" />

        <!-- Justificatif (Grands blocs de la Maquette) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Justificatif"
            android:textColor="#1F2937"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100.dp"
            android:layout_marginTop="8.dp"
            android:layout_marginBottom="8.dp"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardTakePhoto"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6.dp"
                android:layout_weight="1"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="8.dp"
                app:cardElevation="1.dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📷"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4.dp"
                        android:text="Prendre une photo"
                        android:textColor="#1F2937"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardSelectGallery"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6.dp"
                android:layout_weight="1"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="8.dp"
                app:cardElevation="1.dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🖼️"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4.dp"
                        android:text="Importer photo / PDF"
                        android:textColor="#1F2937"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <TextView
            android:id="@+id/tvPdfStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24.dp"
            android:text="Aucun fichier attaché"
            android:textColor="#6B7280"
            android:textSize="12sp" />

        <!-- Bouton Enregistrer Vert -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="54.dp"
            android:backgroundTint="#2E7D32"
            android:text="Enregistrer le Document"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
