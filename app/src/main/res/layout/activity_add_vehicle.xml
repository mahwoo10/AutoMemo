<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:padding="16.dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ajouter / Enregistrer un Document"
            android:textColor="#0F2537"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16.dp"/>

        <!-- Infos Véhicule -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Véhicule &amp; Immatriculation"
            android:textColor="#1F2937"
            android:textStyle="bold"
            android:layout_marginBottom="4.dp"/>

        <EditText
            android:id="@+id/etVehicleName"
            android:layout_width="match_parent"
            android:layout_height="48.dp"
            android:background="@android:color/white"
            android:paddingHorizontal="12.dp"
            android:hint="Ex: Toyota RAV4"
            android:textColor="#1F2937"
            android:textColorHint="#9CA3AF"
            android:inputType="text"
            android:layout_marginBottom="8.dp"/>

        <EditText
            android:id="@+id/etLicensePlate"
            android:layout_width="match_parent"
            android:layout_height="48.dp"
            android:background="@android:color/white"
            android:paddingHorizontal="12.dp"
            android:hint="Immatriculation (ex: B-4567 CD)"
            android:textColor="#1F2937"
            android:textColorHint="#9CA3AF"
            android:inputType="text"
            android:layout_marginBottom="16.dp"/>

        <!-- Infos Propriétaire -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Coordonnées du Propriétaire"
            android:textColor="#1F2937"
            android:textStyle="bold"
            android:layout_marginBottom="4.dp"/>

        <EditText
            android:id="@+id/etOwnerName"
            android:layout_width="match_parent"
            android:layout_height="48.dp"
            android:background="@android:color/white"
            android:paddingHorizontal="12.dp"
            android:hint="Nom complet du propriétaire"
            android:textColor="#1F2937"
            android:textColorHint="#9CA3AF"
            android:inputType="textPersonName"
            android:layout_marginBottom="8.dp"/>

        <EditText
            android:id="@+id/etOwnerPhone"
            android:layout_width="match_parent"
            android:layout_height="48.dp"
            android:background="@android:color/white"
            android:paddingHorizontal="12.dp"
            android:hint="Téléphone (ex: 97000000)"
            android:textColor="#1F2937"
            android:textColorHint="#9CA3AF"
            android:inputType="phone"
            android:layout_marginBottom="16.dp"/>

        <!-- Date d'Échéance -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Visite Technique / Contrôle Technique"
            android:textColor="#1F2937"
            android:textStyle="bold"
            android:layout_marginBottom="4.dp"/>

        <Button
            android:id="@+id/btnPickExpiryDate"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📅 Sélectionner la Date d'Expiration"
            android:layout_marginBottom="4.dp"/>

        <TextView
            android:id="@+id/tvSelectedDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aucune date sélectionnée"
            android:textColor="#6B7280"
            android:textSize="12sp"
            android:layout_marginBottom="16.dp"/>

        <!-- Import du justificatif (Photo / Galerie / PDF) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Justificatif (Photo ou PDF)"
            android:textColor="#1F2937"
            android:textStyle="bold"
            android:layout_marginBottom="6.dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8.dp">

            <Button
                android:id="@+id/btnSelectPhoto"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4.dp"
                android:text="📷 Photo / Galerie"/>

            <Button
                android:id="@+id/btnSelectPdf"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4.dp"
                android:text="📄 Fichier PDF"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvPdfStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aucun fichier attaché"
            android:textColor="#6B7280"
            android:textSize="12sp"
            android:layout_marginBottom="24.dp"/>

        <!-- Enregistrer -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="54.dp"
            android:backgroundTint="#2E7D32"
            android:text="Enregistrer le Document"
            android:textColor="@android:color/white"
            android:textStyle="bold"/>

    </LinearLayout>
</ScrollView>
